<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="HeaderRoot"
        Width="{DynamicResource RowWidth}"
        Height="{DynamicResource HeaderHeight}"
        Background="Transparent">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="4,0,0,4">
    <!-- Same hue as the stripe down every row in this group. The swatch is what
         ties the heading to its rows without repeating the name on each one. -->
    <Rectangle x:Name="Swatch"
               Width="8" Height="8"
               RadiusX="{DynamicResource SwatchRadius}" RadiusY="{DynamicResource SwatchRadius}"
               VerticalAlignment="Center" />
    <!-- The workspace's icon, in place of the swatch when the preset lists
         icons. Wider than the swatch for the glyph, and pulled in by the
         difference, so the label starts where it does after a swatch. -->
    <TextBlock x:Name="Icon"
               Width="12"
               Margin="-2,0,-2,0"
               TextAlignment="Center"
               VerticalAlignment="Center"
               FontFamily="Segoe UI Symbol"
               FontSize="12"
               Foreground="{DynamicResource BrushText}"
               Effect="{DynamicResource TextGlow}"
               Visibility="Collapsed"
               Text="" />
    <TextBlock x:Name="HeaderLabel"
                 Effect="{DynamicResource TextGlow}"
               Margin="8,0,0,0"
               VerticalAlignment="Center"
               FontFamily="{DynamicResource FontHeader}"
               FontSize="{DynamicResource SizeHeader}"
               FontWeight="{DynamicResource HeaderWeight}"
               Foreground="{DynamicResource BrushTextDim}"
               TextTrimming="CharacterEllipsis"
               Text="" />
    <!-- New session in this group's folder, right after its name and written
         in the name's own font, size and colour, so it reads as part of the
         heading in every preset. Shown by the script only for a group whose
         rows have a folder on this PC, and faded in while the pointer is on
         the heading, so a calm card shows no extra marks. Under the pointer
         it takes the brighter text colour. The padding widens what a click
         can land on beyond the thin glyph. -->
    <TextBlock x:Name="NewButton"
               Text="+"
               Margin="4,0,0,0"
               Padding="3,0,3,0"
               VerticalAlignment="Center"
               Background="Transparent"
               Cursor="Hand"
               Opacity="0"
               Visibility="Collapsed"
               Effect="{DynamicResource TextGlow}"
               FontFamily="{DynamicResource FontHeader}"
               FontSize="{DynamicResource SizeHeader}"
               FontWeight="{DynamicResource HeaderWeight}">
      <TextBlock.Style>
        <Style TargetType="TextBlock">
          <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </TextBlock.Style>
    </TextBlock>
  </StackPanel>
</Border>
