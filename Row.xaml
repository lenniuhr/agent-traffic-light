<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="RowBg"
        Width="{DynamicResource RowWidth}"
        Height="{DynamicResource RowHeight}"
        CornerRadius="{DynamicResource RowCorner}"
        BorderThickness="{DynamicResource RowEdgeThickness}"
        BorderBrush="{DynamicResource BrushRowEdge}"
        Background="{DynamicResource BrushRowBase}"
        Cursor="Hand">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="22" />
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
      <ColumnDefinition Width="{DynamicResource TimerWidth}" />
      <!-- The End button, on rows whose session outlives its window. Takes no room elsewhere. -->
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- The preset's sheen over the row's fill, under its text and stripe, and
         the second line just inside the row's outline. Both sit inside the
         outline, so they take the inner corner. -->
    <Border Grid.ColumnSpan="6"
            CornerRadius="{DynamicResource RowInnerCorner}"
            Background="{DynamicResource RowGloss}"
            IsHitTestVisible="False" />
    <Border Grid.ColumnSpan="6"
            CornerRadius="{DynamicResource RowInnerCorner}"
            BorderThickness="{DynamicResource RowInnerEdgeThickness}"
            BorderBrush="{DynamicResource BrushRowInnerEdge}"
            IsHitTestVisible="False" />

    <!-- The stripe does two jobs: it carries the workspace colour when more than
         one is open, and it holds the model name, turned on its side.

         Putting the model here is what frees the right-hand column to hold only
         the time, which is what stopped the two of them colliding. It also means
         the stripe is always drawn, even with a single workspace open, where it
         takes a neutral grey instead of a workspace hue.

         Full row height with square ends and only the left corners rounded, so
         it sits flush inside the row's own corner instead of poking out of it. A
         Border rather than a Rectangle, because a Rectangle can only round all
         four corners at once. -->
    <Border x:Name="Stripe"
            Grid.Column="0"
            Width="14"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Margin="{DynamicResource StripeMargin}"
            CornerRadius="{DynamicResource StripeCorner}">
      <Grid>
        <!-- The session's own pattern over the stripe's colour, for a preset
             that lists patterns. Empty otherwise. -->
        <Border x:Name="StripePattern" CornerRadius="{DynamicResource StripeCorner}" />
        <TextBlock x:Name="Model"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource FontText}"
                   FontSize="{DynamicResource SizeModel}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource BrushStripeText}"
                   Text="">
          <TextBlock.LayoutTransform>
            <RotateTransform Angle="-90" />
          </TextBlock.LayoutTransform>
        </TextBlock>
      </Grid>
    </Border>

    <!-- The dot means this session wants something from you that you have not
         opened yet: it shows on a finished or blocked row until its terminal
         window comes to the front, and nowhere else. A dot read as "busy" was
         the wrong way round, since a busy session is the one that needs nothing. -->
    <Ellipse x:Name="Dot"
             Grid.Column="1"
             Width="9" Height="9"
             HorizontalAlignment="Left"
             VerticalAlignment="Center"
             Margin="4,0,0,0"
             Visibility="Collapsed"
             Fill="{DynamicResource BrushWorking}" />

    <!-- A working session gets a turning ring instead: three quarters of a
         circle, the usual sign for "busy, leave it", in the plain text colour so
         it never competes with the blue dot. The script turns every ring with
         one shared rotation, so they all move in step. -->
    <Path x:Name="Spinner"
          Grid.Column="1"
          Width="10" Height="10"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Margin="3,0,0,0"
          RenderTransformOrigin="0.5,0.5"
          Stroke="{DynamicResource BrushTextDim}"
          StrokeThickness="1.6"
          StrokeStartLineCap="Round"
          StrokeEndLineCap="Round"
          Visibility="Collapsed"
          Data="M 5,1 A 4,4 0 1 1 1,5" />

    <!-- The label, and under it a detail line that only the Marshal row ever
         fills: its open question while it is blocked on you, or a stale note
         when its rounds have stopped. With the detail collapsed the panel holds
         the label alone, centred exactly where it always sat, so every other row
         looks as it did.

         With a detail showing, the pair takes the Unity row's two-line sizes,
         13 over 11, and lifts clear of the context bar along the bottom edge;
         15 over 11 centred in the row put the detail's descenders on the bar.
         Both switches are triggers on the detail's own visibility, so the
         script only shows or hides it and the sizes stay in this file. -->
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
      <StackPanel.Style>
        <Style TargetType="StackPanel">
          <Style.Triggers>
            <DataTrigger Binding="{Binding Visibility, ElementName=Detail}" Value="Visible">
              <Setter Property="Margin" Value="0,0,0,4" />
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </StackPanel.Style>

      <!-- Sentence case, never caps: word shape is what you actually read at a
           glance, and caps destroys it. Ellipsis at the end because these labels
           are Claude's task summaries and run past 40 characters. The size sits
           in the style rather than on the element, because a value set on the
           element would win over the trigger. -->
      <TextBlock x:Name="Label"
                 FontFamily="{DynamicResource FontText}"
                 FontWeight="{DynamicResource LabelWeight}"
                 Foreground="{DynamicResource BrushText}"
                 Effect="{DynamicResource TextGlow}"
                 TextTrimming="CharacterEllipsis"
                 Text="">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource SizeLabel}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding Visibility, ElementName=Detail}" Value="Visible">
                <Setter Property="FontSize" Value="{DynamicResource SizeLabelWithDetail}" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>

      <TextBlock x:Name="Detail"
                 FontFamily="{DynamicResource FontText}"
                 FontSize="{DynamicResource SizeDetail}"
                 Foreground="{DynamicResource BrushTextDim}"
                 Effect="{DynamicResource TextGlow}"
                 TextTrimming="CharacterEllipsis"
                 Visibility="Collapsed"
                 Text="" />
    </StackPanel>

    <!-- The time, alone. The model used to sit stacked underneath it, which put
         it a pixel away from the context bar; it lives in the stripe now.
         A working row counts up here, upright. Any other row shows the clock
         time it stopped as "at 14:05", in italics, so the two are never read
         as the same kind of number. The column is wide enough for the "at". -->

    <!-- A note when this session plays a sound on needing you, set from the row's
         right-click menu. Its own column so a long label is trimmed before it
         instead of running underneath it. -->
    <TextBlock x:Name="SoundMark"
               Grid.Column="3"
               VerticalAlignment="Center"
               Margin="6,0,0,0"
               FontFamily="Segoe UI Symbol"
               FontSize="12"
               Foreground="{DynamicResource BrushTextDim}"
               Visibility="Collapsed"
               Text="&#x266A;" />

    <TextBlock x:Name="Timer"
               Grid.Column="4"
               VerticalAlignment="Center"
               HorizontalAlignment="Right"
               Margin="0,0,10,0"
               FontFamily="{DynamicResource FontTimer}"
               FontSize="{DynamicResource SizeTimer}"
               Foreground="{DynamicResource BrushTextDim}"
               Effect="{DynamicResource TextGlow}"
               Typography.NumeralAlignment="Tabular"
               Text="" />

    <!-- Context in use, as a hairline along the bottom of the row. A bar costs
         no width and no height worth counting, and this is a number you only
         ever want to notice, never read. Translucent white so it works on the
         dark row and on both fills. -->
    <!-- Full row width again. It was shortened to dodge the model text, and with
         the model moved into the stripe there is nothing left to dodge. -->
    <Border x:Name="CtxTrack"
            Grid.ColumnSpan="6"
            Height="2"
            VerticalAlignment="Bottom"
            Margin="20,0,10,4"
            CornerRadius="1"
            Background="{DynamicResource BrushCtxTrack}" />
    <Border x:Name="CtxFill"
            Grid.ColumnSpan="6"
            Height="2"
            Width="0"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Margin="20,0,10,4"
            CornerRadius="1"
            Background="{DynamicResource BrushCtxFill}" />

    <!-- A session that runs on with no window connected to it: the script draws
         the row faded, and pointing at it fades this in, saying what a click
         does, over a veil of the row's own colour that lets the row show
         through. It stops short of the End button, which stays clickable. -->
    <Grid x:Name="Reconnect"
          Grid.ColumnSpan="5"
          Opacity="0"
          Visibility="Collapsed"
          IsHitTestVisible="False">
      <Border CornerRadius="{DynamicResource RowInnerCorner}"
              Background="{DynamicResource BrushRowBase}"
              Opacity="0.72" />
      <TextBlock x:Name="ReconnectText"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource FontText}"
                 FontSize="{DynamicResource SizeLabel}"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource BrushText}"
                 Text="Reconnect" />
    </Grid>

    <!-- Ends a session that keeps running on another machine, where closing its
         window does not end it. Shown only on such rows, and the script asks
         before it ends anything. Defaults sit in the style, not on the element,
         so the hover trigger can change them. -->
    <Border x:Name="EndButton"
            Grid.Column="5"
            VerticalAlignment="Center"
            Margin="0,0,8,0"
            Padding="8,2,8,3"
            CornerRadius="9"
            BorderThickness="1"
            Cursor="Hand"
            Visibility="Collapsed"
            ToolTip="End this session where it runs">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="BorderBrush" Value="{DynamicResource BrushTextDim}" />
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background" Value="#D9363E" />
              <Setter Property="BorderBrush" Value="#D9363E" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <TextBlock FontFamily="{DynamicResource FontText}"
                 FontSize="11"
                 FontWeight="SemiBold"
                 Text="End">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMouseOver, ElementName=EndButton}" Value="True">
                <Setter Property="Foreground" Value="White" />
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </Border>
  </Grid>
</Border>
