<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent Traffic Light"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="404"
        Height="120"
        Left="40"
        Top="40">

  <!-- Every colour, size, corner, outline, font and shadow comes from the
       presets folder: Classic.xaml first, then the chosen preset over it, both
       merged into these resources by the script before anything is drawn.
       Editing a preset and restarting the widget, or picking it again under
       Style, is the whole restyling loop. The width above is only the start;
       the script sets it from the preset's RowWidth. -->
  <Window.Resources>

    <!-- The card's menus: the settings menu and a row's right-click menu. Without
         these they draw in the system's light classic style, which sits badly
         against the dark card. A menu opens in a popup outside this window, so
         lookups from it do not reach the window's resources: New-CardMenu hands
         each menu the window's presets, and these styles read them by key. -->
    <Style x:Key="CardMenu" TargetType="ContextMenu">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="FontFamily" Value="{DynamicResource FontText}" />
      <Setter Property="FontSize" Value="{DynamicResource SizeMenu}" />
      <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <!-- The margin is the shadow's room, as on the card itself. -->
            <Border Margin="0,0,10,10"
                    Padding="4"
                    MinWidth="200"
                    Background="{DynamicResource BrushMenu}"
                    BorderBrush="{DynamicResource BrushMenuEdge}"
                    BorderThickness="{DynamicResource MenuEdgeThickness}"
                    CornerRadius="{DynamicResource MenuCorner}"
                    Effect="{DynamicResource MenuShadow}">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- An item with items of its own is a submenu header: it shows an arrow and
         opens its items beside the menu on hover, in a popup drawn like the menu.
         The popup must be called PART_Popup for the menu to manage it. The offsets
         line its first item up with the header and clear the menu's own edge;
         without room on the right, WPF opens it to the left. -->
    <Style x:Key="CardMenuItem" TargetType="MenuItem">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Foreground" Value="{DynamicResource BrushText}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Grid>
              <Border x:Name="ItemBg" Background="Transparent" CornerRadius="{DynamicResource MenuItemCorner}" Padding="6,6,14,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="Tick"
                             Text="&#x2713;"
                             Visibility="Hidden"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontFamily="Segoe UI Symbol"
                             FontSize="12"
                             Foreground="{DynamicResource BrushMenuTick}" />
                  <ContentPresenter Grid.Column="1"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True"
                                    VerticalAlignment="Center" />
                  <TextBlock x:Name="Arrow"
                             Grid.Column="2"
                             Text="&#x203A;"
                             Visibility="Collapsed"
                             Margin="16,0,0,0"
                             VerticalAlignment="Center"
                             FontSize="15"
                             Foreground="{DynamicResource BrushMenuArrow}" />
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup"
                     Placement="Right"
                     HorizontalOffset="6"
                     VerticalOffset="-5"
                     AllowsTransparency="True"
                     Focusable="False"
                     PopupAnimation="None"
                     IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                <Border Margin="0,0,10,10"
                        Padding="4"
                        MinWidth="200"
                        Background="{DynamicResource BrushMenu}"
                        BorderBrush="{DynamicResource BrushMenuEdge}"
                        BorderThickness="{DynamicResource MenuEdgeThickness}"
                        CornerRadius="{DynamicResource MenuCorner}"
                        Effect="{DynamicResource MenuShadow}">
                  <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="True">
                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
              </Trigger>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource BrushMenuHighlight}" />
              </Trigger>
              <!-- Kept lit while its submenu is open, so it is clear which item the
                   submenu belongs to once the pointer has moved into it. -->
              <Trigger Property="IsSubmenuOpen" Value="True">
                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource BrushMenuHighlight}" />
              </Trigger>
              <!-- A disabled item is the menu's caption, not a dead option. -->
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource BrushTextDim}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CardMenuSeparator" TargetType="Separator">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Separator">
            <Border Height="1" Margin="8,4,8,4" Background="{DynamicResource BrushMenuSeparator}" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <!-- The outer margin is the drop shadow's room to breathe. Without it the
       shadow is clipped by the window bounds and the card looks like a sticker. -->
  <Grid Margin="12">
    <Border x:Name="Card"
            Background="{DynamicResource BrushCard}"
            BorderBrush="{DynamicResource BrushCardEdge}"
            BorderThickness="{DynamicResource CardEdgeThickness}"
            CornerRadius="{DynamicResource CardCorner}"
            Effect="{DynamicResource CardShadow}">

      <!-- Second, lighter stroke just inside the dark one. Together they keep the
           card's edge visible whether it is sitting on a grey editor or on a white
           browser window. It holds everything drawn on the card, so the preset's
           glow goes here, where it traces the contents and not the card. -->
      <Border BorderBrush="{DynamicResource BrushCardInner}"
              BorderThickness="{DynamicResource CardInnerThickness}"
              CornerRadius="{DynamicResource CardInnerCorner}"
              Effect="{DynamicResource ContentGlow}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <!-- The preset's sheen over the whole card, then its decoration, both
               under everything on it. -->
          <Border Grid.RowSpan="4"
                  CornerRadius="{DynamicResource CardInnerCorner}"
                  Background="{DynamicResource CardGloss}"
                  IsHitTestVisible="False" />
          <Border Grid.RowSpan="4"
                  CornerRadius="{DynamicResource CardInnerCorner}"
                  Background="{DynamicResource CardArt}"
                  IsHitTestVisible="False" />

          <!-- The preset's corner ornament: drawn once for the top left corner
               and mirrored into the other three, so the four always match. -->
          <Border Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                  Width="{DynamicResource CornerArtSize}" Height="{DynamicResource CornerArtSize}"
                  Background="{DynamicResource CardCornerArt}" IsHitTestVisible="False" />
          <Border Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                  Width="{DynamicResource CornerArtSize}" Height="{DynamicResource CornerArtSize}"
                  Background="{DynamicResource CardCornerArt}" IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform ScaleX="-1" /></Border.RenderTransform>
          </Border>
          <Border Grid.RowSpan="4" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                  Width="{DynamicResource CornerArtSize}" Height="{DynamicResource CornerArtSize}"
                  Background="{DynamicResource CardCornerArt}" IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform ScaleY="-1" /></Border.RenderTransform>
          </Border>
          <Border Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Width="{DynamicResource CornerArtSize}" Height="{DynamicResource CornerArtSize}"
                  Background="{DynamicResource CardCornerArt}" IsHitTestVisible="False"
                  RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform ScaleX="-1" ScaleY="-1" /></Border.RenderTransform>
          </Border>

          <!-- Today's time with at least one session open. The height is fixed
               because the script sizes the window from it before WPF has
               measured anything. Tabular digits keep the number from shifting
               sideways as it counts. The menu button, the two small lines and
               the number are all centred in the box. They used to sit on the
               number's baseline, by a margin tuned to Classic's fonts, and every
               other preset's fonts put the lines off it and the button out of
               line with both; centred, they line up whatever a preset sets. The
               right margin lines the timer up with the row timers below. -->
          <Border x:Name="WorkClock" Grid.Row="0" Height="32" Margin="14,10,16,0">
            <Grid>
              <!-- The settings menu. Three bars rather than a gear, because it
                   opens a menu and that is the sign people read as one. The
                   transparent background makes the whole box clickable, not only
                   the strokes of the glyph. -->
              <TextBlock x:Name="MenuButton"
                         Text="&#x2630;"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         Padding="0,0,6,0"
                         FontSize="16"
                         Background="Transparent"
                         Cursor="Hand"
                         ToolTip="Settings"
                         Foreground="{DynamicResource BrushTextDim}" />
              <StackPanel HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Margin="24,0,0,0">
                <TextBlock Text="VIBING SESSION" Effect="{DynamicResource TextGlow}"
                           FontFamily="{DynamicResource FontCaption}"
                           FontWeight="{DynamicResource ClockWeight}"
                           FontSize="{DynamicResource SizeClockCaption}"
                           Foreground="{DynamicResource BrushText}" />
                <TextBlock x:Name="WorkClockSub" Effect="{DynamicResource TextGlow}"
                           Text=""
                           FontFamily="{DynamicResource FontCaption}"
                           FontSize="{DynamicResource SizeClockCaption}"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource BrushTextDim}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <!-- The eye hides the faded rows, closed sessions and those with
                     no window here, and shows them again. Drawn, not a glyph, so
                     every preset's fonts show it; struck through while they are
                     hidden. The transparent background makes the whole box
                     clickable, as for the menu button. -->
                <Border x:Name="EyeButton" Width="24" Height="24" Margin="0,0,8,0"
                        VerticalAlignment="Center" Background="Transparent" Cursor="Hand">
                  <Path x:Name="EyeGlyph" Width="20" Height="20" Stretch="None"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Stroke="{DynamicResource BrushTextDim}" StrokeThickness="1.5"
                        StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                </Border>
                <!-- The clock's own halo sits on a wrapper, so it adds to the text
                     glow the clock shares with every other text. -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Effect="{DynamicResource ClockGlow}">
                  <TextBlock x:Name="WorkClockText" Effect="{DynamicResource TextGlow}"
                             Text="0:00:00"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Center"
                             FontFamily="{DynamicResource FontClock}"
                             FontWeight="{DynamicResource ClockWeight}"
                             FontStretch="Condensed"
                             FontSize="{DynamicResource SizeClock}"
                             Typography.NumeralAlignment="Tabular"
                             Foreground="{DynamicResource BrushText}" />
                </Border>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Rows are positioned by hand on a Canvas rather than stacked, because
               a row that changes state slides to its new place and only a Canvas
               lets us animate Top. The script sets the margin from CardPadding. -->
          <Canvas x:Name="RowCanvas" Grid.Row="1" Margin="10,10,10,0" />

          <TextBlock x:Name="WarnText" Effect="{DynamicResource TextGlow}"
                     Grid.Row="2"
                     Margin="14,2,14,8"
                     FontFamily="{DynamicResource FontText}"
                     FontSize="{DynamicResource SizeHeader}"
                     Foreground="{DynamicResource BrushWarning}"
                     TextTrimming="CharacterEllipsis"
                     Visibility="Collapsed" />

          <!-- How much of the Claude subscription's limits is used: the five-hour
               window and the week, each with the time it resets. The account is
               the one the Claude login on this PC belongs to. Each line is switched
               on and off in the settings menu, and both stay collapsed until the
               first reading arrives. A bar is two star columns, used and left, so
               the script sets a share rather than a width. The name, the share and
               the reset time each take a column that grows with its text, shared
               by both lines so they stay in line: at Frutiger Aero's larger caption
               "resets Mon 12:00" ran into the share and lost its first letter. The
               least widths are the old fixed ones, so text that fits looks as it did. -->
          <StackPanel x:Name="UsagePanel" Grid.Row="3" Margin="14,2,16,10" Visibility="Collapsed"
                      Grid.IsSharedSizeScope="True">
            <Grid x:Name="Usage5h" Height="17">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="58" SharedSizeGroup="UsageName" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="44" SharedSizeGroup="UsagePct" />
                <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="UsageReset" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="5 HOURS" VerticalAlignment="Center" Margin="0,0,6,0" Effect="{DynamicResource TextGlow}"
                         FontFamily="{DynamicResource FontCaption}" FontSize="{DynamicResource SizeClockCaption}"
                         Foreground="{DynamicResource BrushTextDim}" />
              <Grid Grid.Column="1" Height="{DynamicResource UsageBarHeight}" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="Usage5hUsed" Width="0*" />
                  <ColumnDefinition x:Name="Usage5hLeft" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{DynamicResource BrushUsageTrack}" CornerRadius="{DynamicResource UsageBarCorner}" />
                <Border x:Name="Usage5hFill" Background="{DynamicResource BrushUsageFill}" CornerRadius="{DynamicResource UsageBarCorner}" />
              </Grid>
              <TextBlock x:Name="Usage5hPct" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Effect="{DynamicResource TextGlow}" Typography.NumeralAlignment="Tabular"
                         FontFamily="{DynamicResource FontCaption}" FontSize="{DynamicResource SizeClockCaption}"
                         Foreground="{DynamicResource BrushText}" />
              <TextBlock x:Name="Usage5hReset" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                         Effect="{DynamicResource TextGlow}" Typography.NumeralAlignment="Tabular"
                         FontFamily="{DynamicResource FontCaption}" FontSize="{DynamicResource SizeClockCaption}"
                         Foreground="{DynamicResource BrushTextDim}" />
            </Grid>
            <Grid x:Name="UsageWeek" Height="17">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="58" SharedSizeGroup="UsageName" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" MinWidth="44" SharedSizeGroup="UsagePct" />
                <ColumnDefinition Width="Auto" MinWidth="96" SharedSizeGroup="UsageReset" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="WEEK" VerticalAlignment="Center" Margin="0,0,6,0" Effect="{DynamicResource TextGlow}"
                         FontFamily="{DynamicResource FontCaption}" FontSize="{DynamicResource SizeClockCaption}"
                         Foreground="{DynamicResource BrushTextDim}" />
              <Grid Grid.Column="1" Height="{DynamicResource UsageBarHeight}" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition x:Name="UsageWeekUsed" Width="0*" />
                  <ColumnDefinition x:Name="UsageWeekLeft" Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="2" Background="{DynamicResource BrushUsageTrack}" CornerRadius="{DynamicResource UsageBarCorner}" />
                <Border x:Name="UsageWeekFill" Background="{DynamicResource BrushUsageFill}" CornerRadius="{DynamicResource UsageBarCorner}" />
              </Grid>
              <TextBlock x:Name="UsageWeekPct" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Effect="{DynamicResource TextGlow}" Typography.NumeralAlignment="Tabular"
                         FontFamily="{DynamicResource FontCaption}" FontSize="{DynamicResource SizeClockCaption}"
                         Foreground="{DynamicResource BrushText}" />
              <TextBlock x:Name="UsageWeekReset" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="6,0,0,0"
                         Effect="{DynamicResource TextGlow}" Typography.NumeralAlignment="Tabular"
                         FontFamily="{DynamicResource FontCaption}" FontSize="{DynamicResource SizeClockCaption}"
                         Foreground="{DynamicResource BrushTextDim}" />
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
