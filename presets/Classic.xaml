<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- The card's own look, and the base of every other preset. Each key here is
       read by name, by the templates through DynamicResource and by the script
       through FindResource. Another preset in this folder holds only the keys
       it changes; the card loads this file first and lays the chosen preset over
       it, so anything a preset leaves out comes from here. Add a key here first
       and a preset can then override it. -->

  <SolidColorBrush x:Key="BrushCard"        Color="#14161A" />
  <SolidColorBrush x:Key="BrushCardEdge"    Color="#0A0B0E" />
  <SolidColorBrush x:Key="BrushCardInner"   Color="#1AFFFFFF" />
  <SolidColorBrush x:Key="BrushText"        Color="#E8EBEF" />
  <SolidColorBrush x:Key="BrushTextDim"     Color="#8B94A1" />

  <!-- Row states. Blue is the calm one on purpose: it has the lowest salience
       of the three, so a card full of working sessions stays quiet.

       The two fills are deliberately dark and desaturated. A saturated block
       of colour on a dark card reads as an alarm even when the news is good,
       and a finished session is good news. These sit on the card rather than
       glowing off it, and the signal is carried by the fill covering the whole
       row and by where the row sorts to, not by shouting.

       Green for finished, amber for blocked, and no red anywhere: green
       against red is the one pair roughly one man in twelve cannot separate,
       and dropping red entirely is what frees green to mean "done". -->
  <SolidColorBrush x:Key="BrushWorking"     Color="#4C9BE8" />
  <SolidColorBrush x:Key="BrushWaiting"     Color="#2C6650" />
  <SolidColorBrush x:Key="BrushBlocked"     Color="#9A6526" />

  <!-- A working row is not transparent. Left as nothing it dissolved into the
       card and you could not see where one row ended and the next began; a
       lift of a few points over the card background is enough to give every
       row a visible shape without putting colour on a session that is simply
       getting on with its work. -->
  <SolidColorBrush x:Key="BrushRowBase"     Color="#1E222A" />
  <SolidColorBrush x:Key="BrushTextOnWait"  Color="#E6F3EC" />
  <SolidColorBrush x:Key="BrushTextOnBlock" Color="#FBEEDD" />

  <!-- The timer is secondary information on a filled row exactly as it is on
       a dark one, so it gets the same treatment: the row's text colour pulled
       back towards the fill underneath it. Full-strength white on the fill
       made the number compete with the label. -->
  <SolidColorBrush x:Key="BrushTimerOnWait"  Color="#9CBBAE" />
  <SolidColorBrush x:Key="BrushTimerOnBlock" Color="#D4B794" />

  <!-- The model name is set into the stripe, so it needs to read against a
       workspace hue rather than against the row. All the stripe colours are
       light, so it is near-black. -->
  <SolidColorBrush x:Key="BrushStripeText"   Color="#16181D" />

  <!-- The stripe when only one workspace is open and there is nothing to tell
       apart. It still has to hold the model name, so it stays light. -->
  <SolidColorBrush x:Key="BrushWsNeutral"    Color="#9AA3B2" />

  <!-- Context bar. Translucent white rather than a fixed colour, so the same
       two brushes read correctly on the dark row and on both fills. The high
       mark is a bright amber, which is the only moment this bar is meant to
       be looked at rather than merely noticed. -->
  <SolidColorBrush x:Key="BrushCtxTrack"     Color="#24FFFFFF" />
  <SolidColorBrush x:Key="BrushCtxFill"      Color="#8CFFFFFF" />
  <SolidColorBrush x:Key="BrushCtxHigh"      Color="#E8A33D" />

  <!-- Workspace hues for the stripe and the heading swatch. Assigned by
       position in the sorted list of open workspaces, so two of them never
       draw the same colour. Deliberately violet and pink first: neither can be
       mistaken for the blue working dot or for either of the two state fills. -->
  <SolidColorBrush x:Key="BrushWs0"         Color="#9B8CF0" />
  <SolidColorBrush x:Key="BrushWs1"         Color="#E48FB8" />
  <SolidColorBrush x:Key="BrushWs2"         Color="#5FC8D8" />
  <SolidColorBrush x:Key="BrushWs3"         Color="#B8B4C8" />

  <!-- Icons that tell the workspace headings apart in place of the coloured
       square, as symbols separated by spaces. Each workspace draws one by its
       name, so it keeps the same icon from one start to the next, and no two
       open workspaces share one. None here: Classic tells them apart by the
       hues above. A preset that sets icons usually gives every stripe one
       colour, since the heading now carries the difference. -->
  <sys:String x:Key="WorkspaceIcons"></sys:String>

  <!-- What the stripe's colour says. Workspace: the hues above, matching the
       heading's swatch. Model: the session's model, in the brushes below,
       which only a preset that picks Model uses. -->
  <sys:String x:Key="StripeColour">Workspace</sys:String>
  <SolidColorBrush x:Key="BrushModelOpus"   Color="#9AA3B2" />
  <SolidColorBrush x:Key="BrushModelFable"  Color="#9AA3B2" />
  <SolidColorBrush x:Key="BrushModelSonnet" Color="#9AA3B2" />
  <SolidColorBrush x:Key="BrushModelHaiku"  Color="#9AA3B2" />
  <SolidColorBrush x:Key="BrushModelOther"  Color="#9AA3B2" />

  <!-- Patterns over the stripe, one per session, so a session can be found
       again at a glance: names separated by spaces, from hatch, crosshatch,
       plus, dots, bars, chevron, checker, rails and plain. No two open
       sessions share one while there are enough, and a session keeps its
       pattern while its window stays open. None here. -->
  <sys:String x:Key="StripePatterns"></sys:String>
  <SolidColorBrush x:Key="BrushStripePattern" Color="#8016181D" />

  <!-- Whether the stripe carries the model's name. A preset that says the
       model by colour can leave it out; the name then shows on hovering the
       stripe. -->
  <sys:Boolean x:Key="StripeModelName">True</sys:Boolean>

  <!-- Stripe of a Unity editor that runs headless. A warm sand, because every
       hue above already means a workspace or a state, and an editor row must
       not read as either. An editor with a window keeps the neutral stripe. -->
  <SolidColorBrush x:Key="BrushHeadless"    Color="#D9C38C" />

  <!-- Stripe of a Unity editor with a window. The neutral grey here, a key of
       its own so a preset can colour it without touching the agents' stripes. -->
  <SolidColorBrush x:Key="BrushUnityEditor" Color="#9AA3B2" />

  <!-- An outline round each row, in the colour of its state. None here: the
       fill carries the state on this card. A preset that draws its rows as
       outlines sets the thickness and the three colours. A Unity row has no
       state and takes the working one. -->
  <Thickness x:Key="RowEdgeThickness">0</Thickness>
  <SolidColorBrush x:Key="BrushRowEdge"        Color="Transparent" />
  <SolidColorBrush x:Key="BrushRowEdgeOnWait"  Color="Transparent" />
  <SolidColorBrush x:Key="BrushRowEdgeOnBlock" Color="Transparent" />

  <!-- A second, lighter line just inside the row's outline, as Aero drew its
       buttons: a dark edge with a highlight inside it. None here. The corner
       is one less than the row's, since the line sits one pixel in. -->
  <Thickness x:Key="RowInnerEdgeThickness">0</Thickness>
  <SolidColorBrush x:Key="BrushRowInnerEdge"   Color="Transparent" />
  <CornerRadius x:Key="RowInnerCorner">7</CornerRadius>

  <!-- How far the stripe reaches past the row's inside. A preset with outlines
       pulls it out over them, so the stripe is the row's left side instead of
       a block framed by the outline. -->
  <Thickness x:Key="StripeMargin">0</Thickness>

  <!-- The "wants you" dot on a blocked row. Elsewhere it is the working blue;
       a preset that fills a blocked row with that same colour sets this so the
       dot does not vanish into the fill. -->
  <SolidColorBrush x:Key="BrushDotOnBlock"     Color="#4C9BE8" />

  <!-- The card's menus. The text and the caption take BrushText and
       BrushTextDim; these are the menu's own surface. The tick is the working
       blue, the one accent the card uses. -->
  <SolidColorBrush x:Key="BrushMenu"          Color="#1E222A" />
  <SolidColorBrush x:Key="BrushMenuEdge"      Color="#2E333D" />
  <SolidColorBrush x:Key="BrushMenuHighlight" Color="#2A303A" />
  <SolidColorBrush x:Key="BrushMenuTick"      Color="#4C9BE8" />
  <SolidColorBrush x:Key="BrushMenuArrow"     Color="#8B94A1" />
  <SolidColorBrush x:Key="BrushMenuSeparator" Color="#24FFFFFF" />

  <!-- Corners. The card's inner stroke sits one pixel inside its edge, so its
       radius is one less. The stripe rounds only its left corners, so it sits
       flush inside the row's own corner instead of poking out of it. -->
  <CornerRadius x:Key="CardCorner">10</CornerRadius>
  <CornerRadius x:Key="CardInnerCorner">9</CornerRadius>
  <CornerRadius x:Key="RowCorner">8</CornerRadius>
  <CornerRadius x:Key="StripeCorner">6,0,0,6</CornerRadius>
  <CornerRadius x:Key="MenuCorner">8</CornerRadius>
  <CornerRadius x:Key="MenuItemCorner">5</CornerRadius>
  <sys:Double x:Key="SwatchRadius">2</sys:Double>

  <!-- A dark edge and, just inside it, a second lighter one. Together they keep
       the card's edge visible whether it is sitting on a grey editor or on a
       white browser window. -->
  <Thickness x:Key="CardEdgeThickness">1</Thickness>
  <Thickness x:Key="CardInnerThickness">1</Thickness>
  <Thickness x:Key="MenuEdgeThickness">1</Thickness>

  <!-- Shadows. A preset without them sets a shadow with Opacity 0: a null in a
       preset counts as not set, so Classic's shadow would show through, and
       the card refuses one. The card's margin round the outside is the
       shadow's room, so it stays either way. -->
  <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="20" ShadowDepth="2" Opacity="0.35" Direction="270" />
  <DropShadowEffect x:Key="MenuShadow" Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.45" Direction="270" />

  <!-- A glow round everything drawn on the card: text, outlines and filled
       rows, but not the card's own background. It traces whatever is opaque,
       so a preset that glows leaves its rows unfilled where the text is meant
       to glow.

       None here, and none means null, not a glow of no strength: an effect
       costs its drawing on every frame whether it shows or not, and on every
       text it took the card from a fifth of a core to half. A preset that
       glows sets one; a null here is the one place a null is allowed. -->
  <x:Null x:Key="ContentGlow" />

  <!-- A halo behind the text alone, where ContentGlow lights up the rows too.
       None here, as null for the same reason. -->
  <x:Null x:Key="TextGlow" />

  <!-- A halo round the clock alone, on top of any TextGlow. None here, as null
       for the same reason: the clock is one text that changes once a second,
       so a preset that lights only it pays far less than one lighting all. -->
  <x:Null x:Key="ClockGlow" />

  <!-- A sheen laid over the card and over every row, under their text: the
       gloss of a glass look. None here. Gradients, so a preset can light the
       top and let it fall away; a row's state colour stays its fill
       underneath, which is what the script animates. -->
  <LinearGradientBrush x:Key="CardGloss" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00FFFFFF" Offset="0" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RowGloss" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#00FFFFFF" Offset="0" />
  </LinearGradientBrush>

  <!-- Decoration on the card, over the sheen and behind the rows: bubbles,
       light, whatever a preset draws. Empty here. Drawn at its own size from
       the card's top left corner, not stretched, so a preset draws in card
       pixels and the art stays put as the card grows and shrinks. -->
  <DrawingBrush x:Key="CardArt" Stretch="None" AlignmentX="Left" AlignmentY="Top">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="Transparent">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,0,1,1" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- An ornament for the card's corners: drawn once, for the top left corner
       in a box CornerArtSize square from 0,0, and mirrored into the other
       three. None here, at size 0, so it takes no room and costs nothing. -->
  <sys:Double x:Key="CornerArtSize">0</sys:Double>
  <DrawingBrush x:Key="CardCornerArt" Stretch="None" AlignmentX="Left" AlignmentY="Top">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="Transparent">
        <GeometryDrawing.Geometry>
          <RectangleGeometry Rect="0,0,1,1" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>

  <!-- Type. Sentence case, never caps, in the rows: word shape is what you
       actually read at a glance. The clock has a face of its own, with tabular
       digits so it does not shift sideways as it counts. -->
  <FontFamily x:Key="FontText">Segoe UI</FontFamily>
  <FontFamily x:Key="FontClock">Bahnschrift</FontFamily>

  <!-- Faces of their own for the group headings, the timers and the two lines
       beside the clock, for a preset that wants more faces than two. A preset
       that leaves them out gets its own FontText for the headings and timers
       and its own FontClock for the two lines, as before these keys. A face
       can also come from presets\fonts\ by a relative path, fonts/#Name. -->
  <FontFamily x:Key="FontHeader">Segoe UI</FontFamily>
  <FontFamily x:Key="FontTimer">Segoe UI</FontFamily>
  <FontFamily x:Key="FontCaption">Bahnschrift</FontFamily>

  <!-- The weight of the group headings, and of the clock and the line
       "VIBING SESSION" beside it. A display face with one weight only should
       be set Normal: asked for SemiBold, Windows thickens it by smearing, and
       it stops being readable. -->
  <FontWeight x:Key="HeaderWeight">SemiBold</FontWeight>
  <FontWeight x:Key="ClockWeight">SemiBold</FontWeight>

  <!-- The warning line under the rows, when sessions share a window. The
       blocked colour here; a preset that leaves it out gets its own blocked
       colour, as before this key. -->
  <SolidColorBrush x:Key="BrushWarning" Color="#9A6526" />
  <FontWeight x:Key="LabelWeight">SemiBold</FontWeight>

  <!-- With Marshal's detail line showing, the label takes the Unity row's
       two-line size, 13 over 11, and lifts clear of the context bar; 15 over 11
       put the detail's descenders on the bar. -->
  <sys:Double x:Key="SizeLabel">15</sys:Double>
  <sys:Double x:Key="SizeLabelWithDetail">13</sys:Double>
  <sys:Double x:Key="SizeDetail">11</sys:Double>
  <sys:Double x:Key="SizeTimer">12</sys:Double>
  <sys:Double x:Key="SizeHeader">11</sys:Double>
  <sys:Double x:Key="SizeModel">9</sys:Double>
  <sys:Double x:Key="SizeClock">26</sys:Double>
  <sys:Double x:Key="SizeClockCaption">11</sys:Double>
  <sys:Double x:Key="SizeMenu">13</sys:Double>

  <!-- Density. The script lays the rows out from these, and works out the
       card's width and the context bar's from RowWidth and CardPadding. -->
  <sys:Double x:Key="RowHeight">42</sys:Double>
  <sys:Double x:Key="RowWidth">360</sys:Double>
  <sys:Double x:Key="RowGap">6</sys:Double>
  <sys:Double x:Key="HeaderHeight">22</sys:Double>
  <sys:Double x:Key="GroupGap">8</sys:Double>
  <sys:Double x:Key="CardPadding">10</sys:Double>

  <!-- The timer's column on an agent row, fixed so the times line up down the
       card, and wide enough for "at 14:05" with the row's right margin. -->
  <GridLength x:Key="TimerWidth">58</GridLength>

  <!-- The two buttons on a row whose session keeps running after its window
       closes. Disconnect closes the window here and leaves Claude running;
       Kill stops Claude where it runs. Each icon is a filled shape drawn in a
       16 by 16 box, and a preset may redraw both and colour them at rest and
       under the pointer. Here: a plug pulled from its socket, and a skull. -->
  <PathGeometry x:Key="IconDisconnect"
                Figures="M0,7.25 H2 V8.75 H0 Z
                         M2,5 H6.5 A1,1 0 0 1 7.5,6 V10 A1,1 0 0 1 6.5,11 H2 Z
                         M7.5,6.4 H9.6 V7.4 H7.5 Z M7.5,8.6 H9.6 V9.6 H7.5 Z
                         M12.5,5 H14 V11 H12.5 A1,1 0 0 1 11.5,10 V6 A1,1 0 0 1 12.5,5 Z
                         M14,7.25 H16 V8.75 H14 Z
                         M10.3,2.1 L11.3,3.7 L10.7,4.0 L9.7,2.4 Z
                         M9.7,13.6 L10.7,12.0 L11.3,12.3 L10.3,13.9 Z" />
  <!-- Both icons are PathGeometry, which is what a preset must give too; the
       skull's eyes, nose and the gaps between its teeth are holes cut by the
       even-odd rule. -->
  <PathGeometry x:Key="IconKill" FillRule="EvenOdd"
                Figures="M8,1.5 C4.4,1.5 2,4 2,7.2 C2,9.3 3,10.8 5,11.5 V14.5 H11 V11.5 C13,10.8 14,9.3 14,7.2 C14,4 11.6,1.5 8,1.5 Z
                         M4,7.4 A1.7,1.8 0 1 0 7.4,7.4 A1.7,1.8 0 1 0 4,7.4 Z
                         M8.6,7.4 A1.7,1.8 0 1 0 12,7.4 A1.7,1.8 0 1 0 8.6,7.4 Z
                         M8,9.4 L7.1,11 H8.9 Z
                         M6.9,12.6 H7.5 V14.5 H6.9 Z M8.5,12.6 H9.1 V14.5 H8.5 Z" />
  <SolidColorBrush x:Key="BrushIconButton"           Color="#8B94A1" />
  <SolidColorBrush x:Key="BrushIconButtonBg"         Color="Transparent" />
  <SolidColorBrush x:Key="BrushIconButtonEdge"       Color="Transparent" />
  <SolidColorBrush x:Key="BrushDisconnectHoverBg"    Color="#3A4250" />
  <SolidColorBrush x:Key="BrushDisconnectHoverIcon"  Color="#E8EBEF" />
  <SolidColorBrush x:Key="BrushDisconnectHoverEdge"  Color="Transparent" />
  <SolidColorBrush x:Key="BrushKillHoverBg"          Color="#D9363E" />
  <SolidColorBrush x:Key="BrushKillHoverIcon"        Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrushKillHoverEdge"        Color="Transparent" />
  <!-- The "+" at a repo heading's right end, starting a new session there. On
       whole pixels, so it stays sharp where a preset draws icons aliased. -->
  <PathGeometry x:Key="IconNew" Figures="M7,3 H9 V7 H13 V9 H9 V13 H7 V9 H3 V7 H7 Z" />
  <SolidColorBrush x:Key="BrushNewHoverBg"           Color="#3A4250" />
  <SolidColorBrush x:Key="BrushNewHoverIcon"         Color="#E8EBEF" />
  <SolidColorBrush x:Key="BrushNewHoverEdge"         Color="Transparent" />
  <CornerRadius x:Key="IconButtonCorner">5</CornerRadius>
  <Thickness x:Key="IconButtonEdgeThickness">0</Thickness>
  <EdgeMode x:Key="IconEdgeMode">Unspecified</EdgeMode>

  <!-- The Claude subscription's two limits along the card's bottom: a thin bar
       for each, in the context bar's colours, amber once past 80 %. The fill
       is a DrawingBrush, here of one plain colour, so a preset can print a
       pattern on it; a preset must give a DrawingBrush too. -->
  <sys:Double x:Key="UsageBarHeight">4</sys:Double>
  <CornerRadius x:Key="UsageBarCorner">2</CornerRadius>
  <SolidColorBrush x:Key="BrushUsageTrack" Color="#24FFFFFF" />
  <DrawingBrush x:Key="BrushUsageFill">
    <DrawingBrush.Drawing>
      <GeometryDrawing Brush="#8CFFFFFF"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,1,1" /></GeometryDrawing.Geometry></GeometryDrawing>
    </DrawingBrush.Drawing>
  </DrawingBrush>
  <SolidColorBrush x:Key="BrushUsageHigh"  Color="#E8A33D" />
</ResourceDictionary>
