<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Emulsion: a two colour job on the press, after the Emulsion theme of the
       Nightjar audio studio. Key black and one fluorescent pink, and the whole
       style turns on one rule: the fluorescent is a plate and never an ink.
       It grounds what wants you, and everything set on it is set in key.
       Nothing casts a soft shadow: a raised thing is its second plate pulled
       out of register, hard edged. Only what differs from Classic is here.

       Finished is the fluorescent plate rather than green, since a two colour
       job has no green to give; blocked is the key plate with amber, the one
       warning ink the theme keeps. There is no red. -->

  <SolidColorBrush x:Key="BrushCard"        Color="#DED9E2" />
  <SolidColorBrush x:Key="BrushCardEdge"    Color="#141019" />

  <!-- The frame: solid key ink on three sides. The top band, ruled in the
       fluorescent, is drawn in the card art. -->
  <Thickness x:Key="CardEdgeThickness">3,0,3,3</Thickness>
  <Thickness x:Key="CardInnerThickness">0</Thickness>

  <SolidColorBrush x:Key="BrushText"        Color="#141019" />
  <SolidColorBrush x:Key="BrushTextDim"     Color="#4C4257" />

  <!-- The dot is key on the fluorescent and the fluorescent on key: a two
       colour job has no blue to give it. -->
  <SolidColorBrush x:Key="BrushWorking"     Color="#141019" />
  <SolidColorBrush x:Key="BrushWaiting"     Color="#FF2D94" />
  <SolidColorBrush x:Key="BrushBlocked"     Color="#141019" />
  <SolidColorBrush x:Key="BrushDotOnBlock"  Color="#FF2D94" />

  <SolidColorBrush x:Key="BrushRowBase"     Color="#FAF9FB" />
  <SolidColorBrush x:Key="BrushTextOnWait"  Color="#141019" />
  <SolidColorBrush x:Key="BrushTextOnBlock" Color="#EEC158" />
  <SolidColorBrush x:Key="BrushTimerOnWait"  Color="#B3141019" />
  <SolidColorBrush x:Key="BrushTimerOnBlock" Color="#A49DAB" />

  <!-- Bare stock cut to a key keyline; firmer round the plates. -->
  <Thickness x:Key="RowEdgeThickness">1</Thickness>
  <SolidColorBrush x:Key="BrushRowEdge"        Color="#47141019" />
  <SolidColorBrush x:Key="BrushRowEdgeOnWait"  Color="#141019" />
  <SolidColorBrush x:Key="BrushRowEdgeOnBlock" Color="#E2AC3C" />
  <Thickness x:Key="StripeMargin">-1,-1,0,-1</Thickness>

  <!-- Stripes are the key frame repeated on each row, each session's pattern
       tabbed on it in the fluorescent. Workspaces take an icon on their
       heading; the model's name shows on hovering the stripe. -->
  <SolidColorBrush x:Key="BrushWsNeutral"   Color="#141019" />
  <SolidColorBrush x:Key="BrushWs0"         Color="#141019" />
  <SolidColorBrush x:Key="BrushWs1"         Color="#141019" />
  <SolidColorBrush x:Key="BrushWs2"         Color="#141019" />
  <SolidColorBrush x:Key="BrushWs3"         Color="#141019" />
  <sys:String x:Key="WorkspaceIcons">&#x2699; &#x2B22; &#x271A; &#x25C6; &#x25B2; &#x2316; &#x2731; &#x2691; &#x2708; &#x2693;</sys:String>
  <sys:Boolean x:Key="StripeModelName">False</sys:Boolean>
  <sys:String x:Key="StripePatterns">hatch plus dots bars chevron crosshatch checker</sys:String>
  <SolidColorBrush x:Key="BrushStripePattern" Color="#FF2D94" />

  <!-- Unity editors on the fluorescent plate with a window, a pale tint of
       it headless, the light version of the same editor. -->
  <SolidColorBrush x:Key="BrushUnityEditor" Color="#FF2D94" />
  <SolidColorBrush x:Key="BrushHeadless"    Color="#F7C6DD" />

  <!-- A mid grey that reads on the stock, the plate and the key. -->
  <SolidColorBrush x:Key="BrushCtxTrack"     Color="#338E8397" />
  <SolidColorBrush x:Key="BrushCtxFill"      Color="#8E8397" />
  <SolidColorBrush x:Key="BrushCtxHigh"      Color="#E2AC3C" />

  <SolidColorBrush x:Key="BrushMenu"          Color="#FAF9FB" />
  <SolidColorBrush x:Key="BrushMenuEdge"      Color="#141019" />
  <SolidColorBrush x:Key="BrushMenuHighlight" Color="#59FF2D94" />
  <SolidColorBrush x:Key="BrushMenuTick"      Color="#B00068" />
  <SolidColorBrush x:Key="BrushMenuArrow"     Color="#4C4257" />
  <SolidColorBrush x:Key="BrushMenuSeparator" Color="#33141019" />

  <CornerRadius x:Key="CardCorner">0</CornerRadius>
  <CornerRadius x:Key="CardInnerCorner">0</CornerRadius>
  <CornerRadius x:Key="RowCorner">0</CornerRadius>
  <CornerRadius x:Key="RowInnerCorner">0</CornerRadius>
  <CornerRadius x:Key="StripeCorner">0</CornerRadius>
  <CornerRadius x:Key="MenuCorner">0</CornerRadius>
  <CornerRadius x:Key="MenuItemCorner">0</CornerRadius>
  <sys:Double x:Key="SwatchRadius">0</sys:Double>

  <!-- The second plate out of register: the fluorescent, hard edged, down and
       to the right. -->
  <DropShadowEffect x:Key="CardShadow" Color="#FF2D94" BlurRadius="0" ShadowDepth="6" Opacity="1" Direction="315" />
  <DropShadowEffect x:Key="MenuShadow" Color="#FF2D94" BlurRadius="0" ShadowDepth="4" Opacity="1" Direction="315" />

  <!-- The theme's heading face is Oswald, a narrow grotesque; where neither
       it nor Arial Narrow is installed, the clock keeps Bahnschrift. -->
  <FontFamily x:Key="FontClock">Oswald, Arial Narrow, Bahnschrift</FontFamily>

  <!-- The board is one mark only: a registration cross on a square grid,
       drawn at random down both margins, where the rows leave the board bare,
       printed in the fluorescent. Drawn from the card's top left in card
       pixels and cut off at its bottom. Across the top, the frame's key band
       with its fluorescent rule. -->
