<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Starburst: a personal homepage from 1999, after the Starburst theme of
       the Nightjar audio studio. Windows 98 grey, real bevels, a navy title
       bar with a rainbow under it, Comic Sans for the words and Impact for
       the clock, link blue, highlighter yellow. A meme, built to be worn for
       an afternoon. Only what differs from Classic is here.

       The colours keep their meaning in the page's own highlighters: link
       blue for the dot, mint for finished, yellow for blocked. There is no
       red. -->

  <SolidColorBrush x:Key="BrushCard"        Color="#C0C0C0" />
  <SolidColorBrush x:Key="BrushCardEdge"    Color="#000000" />
  <SolidColorBrush x:Key="BrushCardInner"   Color="#FFFFFF" />

  <SolidColorBrush x:Key="BrushText"        Color="#000000" />
  <SolidColorBrush x:Key="BrushTextDim"     Color="#383838" />

  <SolidColorBrush x:Key="BrushWorking"     Color="#0000EE" />
  <SolidColorBrush x:Key="BrushWaiting"     Color="#9CFF9C" />
  <SolidColorBrush x:Key="BrushBlocked"     Color="#FFD000" />
  <SolidColorBrush x:Key="BrushDotOnBlock"  Color="#0000EE" />

  <SolidColorBrush x:Key="BrushRowBase"     Color="#E4E4E4" />
  <SolidColorBrush x:Key="BrushTextOnWait"  Color="#000000" />
  <SolidColorBrush x:Key="BrushTextOnBlock" Color="#000000" />
  <SolidColorBrush x:Key="BrushTimerOnWait"  Color="#004D00" />
  <SolidColorBrush x:Key="BrushTimerOnBlock" Color="#5A4200" />

  <!-- Every row a bevelled button: a grey edge, a white line inside it, and
       the key's shine, light at the top and shaded at the bottom. -->
  <Thickness x:Key="RowEdgeThickness">1</Thickness>
  <SolidColorBrush x:Key="BrushRowEdge"        Color="#808080" />
  <SolidColorBrush x:Key="BrushRowEdgeOnWait"  Color="#006600" />
  <SolidColorBrush x:Key="BrushRowEdgeOnBlock" Color="#806000" />
  <Thickness x:Key="RowInnerEdgeThickness">1</Thickness>
  <SolidColorBrush x:Key="BrushRowInnerEdge"   Color="#FFFFFF" />
  <Thickness x:Key="StripeMargin">-1,-1,0,-1</Thickness>
  <LinearGradientBrush x:Key="RowGloss" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#80FFFFFF" Offset="0" />
    <GradientStop Color="#00FFFFFF" Offset="0.45" />
    <GradientStop Color="#00000000" Offset="0.55" />
    <GradientStop Color="#1F000000" Offset="1" />
  </LinearGradientBrush>

  <!-- Stripes are the navy of the page's bubble wallpaper, each session's
       pattern on it in highlighter yellow. Workspaces take a homepage icon
       on their heading; the model's name shows on hovering the stripe. -->
  <SolidColorBrush x:Key="BrushWsNeutral"   Color="#000080" />
  <SolidColorBrush x:Key="BrushWs0"         Color="#000080" />
  <SolidColorBrush x:Key="BrushWs1"         Color="#000080" />
  <SolidColorBrush x:Key="BrushWs2"         Color="#000080" />
  <SolidColorBrush x:Key="BrushWs3"         Color="#000080" />
  <sys:String x:Key="WorkspaceIcons">&#x2605; &#x2709; &#x263A; &#x266B; &#x273F; &#x263C; &#x260E; &#x2708; &#x2665; &#x272A;</sys:String>
  <sys:Boolean x:Key="StripeModelName">False</sys:Boolean>
  <sys:String x:Key="StripePatterns">hatch plus dots bars chevron crosshatch checker</sys:String>
  <SolidColorBrush x:Key="BrushStripePattern" Color="#FFFF00" />

  <!-- Unity editors in link blue with a window, a visited-link lavender
       headless, the light version of the same editor. -->
  <SolidColorBrush x:Key="BrushUnityEditor" Color="#0000EE" />
  <SolidColorBrush x:Key="BrushHeadless"    Color="#C8C8FF" />

  <!-- The page's purple scrollbar. -->
  <SolidColorBrush x:Key="BrushCtxTrack"     Color="#33000000" />
  <SolidColorBrush x:Key="BrushCtxFill"      Color="#800080" />
  <SolidColorBrush x:Key="BrushCtxHigh"      Color="#FF8000" />

  <SolidColorBrush x:Key="BrushMenu"          Color="#C0C0C0" />
  <SolidColorBrush x:Key="BrushMenuEdge"      Color="#000000" />
  <SolidColorBrush x:Key="BrushMenuHighlight" Color="#FFFF00" />
  <SolidColorBrush x:Key="BrushMenuTick"      Color="#0000EE" />
  <SolidColorBrush x:Key="BrushMenuArrow"     Color="#000000" />
  <SolidColorBrush x:Key="BrushMenuSeparator" Color="#808080" />

  <CornerRadius x:Key="CardCorner">0</CornerRadius>
  <CornerRadius x:Key="CardInnerCorner">0</CornerRadius>
  <CornerRadius x:Key="RowCorner">0</CornerRadius>
  <CornerRadius x:Key="RowInnerCorner">0</CornerRadius>
  <CornerRadius x:Key="StripeCorner">0</CornerRadius>
  <CornerRadius x:Key="MenuCorner">0</CornerRadius>
  <CornerRadius x:Key="MenuItemCorner">0</CornerRadius>
  <sys:Double x:Key="SwatchRadius">0</sys:Double>

  <!-- Hard black drop shadows, the 1999 way. -->
  <DropShadowEffect x:Key="CardShadow" Color="#000000" BlurRadius="0" ShadowDepth="3" Opacity="0.6" Direction="315" />
  <DropShadowEffect x:Key="MenuShadow" Color="#000000" BlurRadius="0" ShadowDepth="2" Opacity="0.6" Direction="315" />

  <FontFamily x:Key="FontText">Comic Sans MS</FontFamily>
  <FontFamily x:Key="FontClock">Impact, Arial Black</FontFamily>
  <FontWeight x:Key="LabelWeight">Normal</FontWeight>
  <sys:Double x:Key="SizeLabel">14</sys:Double>
  <sys:Double x:Key="SizeLabelWithDetail">12</sys:Double>
  <GridLength x:Key="TimerWidth">66</GridLength>

  <!-- The active title bar of Windows 98, navy into blue, and the page's
       rainbow rule under it. -->
  <DrawingBrush x:Key="CardArt" Stretch="None" AlignmentX="Left" AlignmentY="Top">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,380,7" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#000080" Offset="0" />
              <GradientStop Color="#1084D0" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Geometry><RectangleGeometry Rect="0,7,380,3" /></GeometryDrawing.Geometry>
          <GeometryDrawing.Brush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="#FF0000" Offset="0" />
              <GradientStop Color="#FFFF00" Offset="0.25" />
              <GradientStop Color="#00FF00" Offset="0.5" />
              <GradientStop Color="#00FFFF" Offset="0.75" />
              <GradientStop Color="#FF00FF" Offset="1" />
            </LinearGradientBrush>
          </GeometryDrawing.Brush>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
