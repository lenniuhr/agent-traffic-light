    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="Transparent"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,30,30" /></GeometryDrawing.Geometry></GeometryDrawing>
        <GeometryDrawing Geometry="M4,27 L4,4 L27,4">
          <GeometryDrawing.Pen><Pen Brush="#D8B848" Thickness="1" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M8,20 L8,8 L20,8">
          <GeometryDrawing.Pen><Pen Brush="#80D8B848" Thickness="0.8" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#E8C048" Geometry="M4,1 L7,4 L4,7 L1,4 Z M27,2.5 L28.5,4 L27,5.5 L25.5,4 Z M4,25.5 L5.5,27 L4,28.5 L2.5,27 Z" />
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>

