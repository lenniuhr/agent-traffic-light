<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Elden Ring: Limgrave under the Erdtree's light. Only what differs from
       Classic is here.

       The colours are measured from a still of Limgrave rather than guessed:
       its shadows are a cool blue-green slate, not black or brown; its middle
       is sage and olive; its haze a pale yellow-green; the Erdtree's light a
       golden white; its falling leaves and the grace a strong gold. The card
       runs from that slate at the bottom left to the hazy sage at the top
       right, where the light comes from, with beams fanning down from there,
       motes of grace and golden leaves drifting through them.

       Kept to simple shapes on purpose: a drawn tree and big glowing orbs read
       as made-up art at this size; points, soft beams and leaves read as light.

       The colours keep their meaning: a cool teal-silver while working, moss
       green when finished, the gold of grace when blocked, and no red. The
       type is Cinzel throughout, roman capitals with small capitals for lower
       case, as the game's menus have it, from presets\fonts\. -->

  <SolidColorBrush x:Key="BrushCard"        Color="#FF142023" />
  <SolidColorBrush x:Key="BrushCardEdge"    Color="#D8B848" />
  <SolidColorBrush x:Key="BrushCardInner"   Color="#40D8D4A9" />

  <SolidColorBrush x:Key="BrushText"        Color="#ECE8CC" />
  <SolidColorBrush x:Key="BrushTextDim"     Color="#A8A876" />

  <SolidColorBrush x:Key="BrushWorking"     Color="#9CC0C0" />
  <SolidColorBrush x:Key="BrushWaiting"     Color="#B0303D2C" />
  <SolidColorBrush x:Key="BrushBlocked"     Color="#B85A4816" />
  <SolidColorBrush x:Key="BrushDotOnBlock"  Color="#FFF0C0" />

  <SolidColorBrush x:Key="BrushRowBase"     Color="#A8142023" />
  <SolidColorBrush x:Key="BrushTextOnWait"  Color="#EEF0D8" />
  <SolidColorBrush x:Key="BrushTextOnBlock" Color="#FFF6D8" />
  <SolidColorBrush x:Key="BrushTimerOnWait"  Color="#B8C49A" />
  <SolidColorBrush x:Key="BrushTimerOnBlock" Color="#E8D08A" />

  <!-- Rows edged in a faint sage, the state's own colour when it needs you;
       the stripe covers the edge on the left, by its thickness. -->
  <Thickness x:Key="RowEdgeThickness">1</Thickness>
  <SolidColorBrush x:Key="BrushRowEdge"        Color="#507A8670" />
  <SolidColorBrush x:Key="BrushRowEdgeOnWait"  Color="#8A9A6A" />
  <SolidColorBrush x:Key="BrushRowEdgeOnBlock" Color="#E8C048" />
  <Thickness x:Key="StripeMargin">-1,-1,0,-1</Thickness>

  <SolidColorBrush x:Key="BrushStripeText"  Color="#142023" />
  <SolidColorBrush x:Key="BrushWsNeutral"   Color="#A8A876" />
  <SolidColorBrush x:Key="BrushWs0"         Color="#D8B848" />
  <SolidColorBrush x:Key="BrushWs1"         Color="#8FA87A" />
  <SolidColorBrush x:Key="BrushWs2"         Color="#9CC0C0" />
  <SolidColorBrush x:Key="BrushWs3"         Color="#C2BF88" />

  <SolidColorBrush x:Key="BrushCtxTrack"     Color="#30D8D4A9" />
  <SolidColorBrush x:Key="BrushCtxFill"      Color="#C2BF88" />
  <SolidColorBrush x:Key="BrushCtxHigh"      Color="#E8C048" />

  <SolidColorBrush x:Key="BrushMenu"          Color="#F2142023" />
  <SolidColorBrush x:Key="BrushMenuEdge"      Color="#D8B848" />
  <SolidColorBrush x:Key="BrushMenuHighlight" Color="#40A8A876" />
  <SolidColorBrush x:Key="BrushMenuTick"      Color="#E8C048" />
  <SolidColorBrush x:Key="BrushMenuArrow"     Color="#A8A876" />
  <SolidColorBrush x:Key="BrushMenuSeparator" Color="#40D8B848" />

  <CornerRadius x:Key="CardCorner">3</CornerRadius>
  <CornerRadius x:Key="CardInnerCorner">2</CornerRadius>
  <CornerRadius x:Key="RowCorner">2</CornerRadius>
  <CornerRadius x:Key="RowInnerCorner">1</CornerRadius>
  <CornerRadius x:Key="StripeCorner">2,0,0,2</CornerRadius>

  <!-- Cinzel has one weight; asked for a heavier one, Windows would smear a
       made-up bold over it. -->
  <FontFamily x:Key="FontText">fonts/#Cinzel, Palatino Linotype</FontFamily>
  <FontFamily x:Key="FontClock">fonts/#Cinzel, Palatino Linotype</FontFamily>
  <FontWeight x:Key="LabelWeight">Normal</FontWeight>
  <FontWeight x:Key="HeaderWeight">Normal</FontWeight>
  <FontWeight x:Key="ClockWeight">Normal</FontWeight>

  <!-- The time in the warm light of grace: a small golden halo round the
       clock alone, which costs little where one round every text would not. -->
  <DropShadowEffect x:Key="ClockGlow" Color="#E8C048" BlurRadius="10" ShadowDepth="0" Opacity="0.55" />

  <!-- The card: blue-green slate at the bottom left rising to the hazy sage of
       the light at the top right. -->
  <LinearGradientBrush x:Key="CardGloss" StartPoint="1,0" EndPoint="0,1">
    <GradientStop Color="#FF5E6B54" Offset="0" />
    <GradientStop Color="#FF35453F" Offset="0.4" />
    <GradientStop Color="#FF1F2E30" Offset="0.75" />
    <GradientStop Color="#FF142023" Offset="1" />
  </LinearGradientBrush>

  <!-- The corners, as the game frames its menus: a fine gold bracket with a
       fainter one inside it, a diamond at the corner and a small one at each
       end. Drawn for the top left corner in a box 30 square; the card mirrors
       it into the other three. -->
  <sys:Double x:Key="CornerArtSize">30</sys:Double>
