<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- A green phosphor screen: one colour, glowing, on black. Only what differs
       from Classic is here.

       With a single hue the states cannot be told apart by colour, so they are
       told apart by loudness, each a step up from the last: a working row is
       plain green text, a finished one is bright text in a bright box, and a
       blocked one is inverse video, black on a solid green block, pulsing.
       The one row that needs you most is the loudest thing on the card.

       Working and finished rows are left unfilled on purpose. The glow traces
       whatever is opaque, so a filled row would glow as a rectangle and its
       text would not glow at all. -->

  <SolidColorBrush x:Key="BrushCard"        Color="#050A06" />
  <SolidColorBrush x:Key="BrushCardEdge"    Color="#1C7A38" />
  <Thickness x:Key="CardInnerThickness">0</Thickness>

  <SolidColorBrush x:Key="BrushText"        Color="#33DD66" />
  <SolidColorBrush x:Key="BrushTextDim"     Color="#1C7A38" />

  <!-- The dot and the bright step. The blocked fill is the brightest green,
       with near-black text and dot on it. -->
  <SolidColorBrush x:Key="BrushWorking"     Color="#8CFFAA" />
  <SolidColorBrush x:Key="BrushWaiting"     Color="Transparent" />
  <SolidColorBrush x:Key="BrushBlocked"     Color="#4DFF7A" />
  <SolidColorBrush x:Key="BrushDotOnBlock"  Color="#021A08" />

  <SolidColorBrush x:Key="BrushRowBase"     Color="Transparent" />
  <SolidColorBrush x:Key="BrushTextOnWait"  Color="#8CFFAA" />
  <SolidColorBrush x:Key="BrushTextOnBlock" Color="#021A08" />
  <SolidColorBrush x:Key="BrushTimerOnWait"  Color="#4FCC74" />
  <SolidColorBrush x:Key="BrushTimerOnBlock" Color="#0A3A16" />

  <Thickness x:Key="RowEdgeThickness">1</Thickness>
  <SolidColorBrush x:Key="BrushRowEdge"        Color="Transparent" />
  <SolidColorBrush x:Key="BrushRowEdgeOnWait"  Color="#8CFFAA" />
  <SolidColorBrush x:Key="BrushRowEdgeOnBlock" Color="#4DFF7A" />

  <!-- Workspaces in four strengths of the one green: harder to tell apart
       than hues, which is the price of the single colour. -->
  <SolidColorBrush x:Key="BrushStripeText"  Color="#021A08" />
  <SolidColorBrush x:Key="BrushWsNeutral"   Color="#33DD66" />
  <SolidColorBrush x:Key="BrushWs0"         Color="#8CFFAA" />
  <SolidColorBrush x:Key="BrushWs1"         Color="#33DD66" />
  <SolidColorBrush x:Key="BrushWs2"         Color="#5CE68A" />
  <SolidColorBrush x:Key="BrushWs3"         Color="#1FA84A" />
  <SolidColorBrush x:Key="BrushHeadless"    Color="#1FA84A" />

  <SolidColorBrush x:Key="BrushCtxTrack"     Color="#2633DD66" />
  <SolidColorBrush x:Key="BrushCtxFill"      Color="#9933DD66" />
  <SolidColorBrush x:Key="BrushCtxHigh"      Color="#8CFFAA" />

  <SolidColorBrush x:Key="BrushMenu"          Color="#050A06" />
  <SolidColorBrush x:Key="BrushMenuEdge"      Color="#1C7A38" />
  <SolidColorBrush x:Key="BrushMenuHighlight" Color="#0F3D1C" />
  <SolidColorBrush x:Key="BrushMenuTick"      Color="#8CFFAA" />
  <SolidColorBrush x:Key="BrushMenuArrow"     Color="#33DD66" />
  <SolidColorBrush x:Key="BrushMenuSeparator" Color="#401C7A38" />

  <CornerRadius x:Key="CardCorner">0</CornerRadius>
  <CornerRadius x:Key="CardInnerCorner">0</CornerRadius>
  <CornerRadius x:Key="RowCorner">0</CornerRadius>
  <CornerRadius x:Key="StripeCorner">0</CornerRadius>
  <CornerRadius x:Key="MenuCorner">0</CornerRadius>
  <CornerRadius x:Key="MenuItemCorner">0</CornerRadius>
  <sys:Double x:Key="SwatchRadius">0</sys:Double>

  <!-- No shadows, but the phosphor's own light bleeding round everything lit. -->
  <DropShadowEffect x:Key="CardShadow" Opacity="0" BlurRadius="0" ShadowDepth="0" />
  <DropShadowEffect x:Key="MenuShadow" Opacity="0" BlurRadius="0" ShadowDepth="0" />
  <DropShadowEffect x:Key="ContentGlow" Color="#33FF66" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />

  <!-- Consolas first: it is the closer of the two to an old terminal's face. -->
  <FontFamily x:Key="FontText">Consolas, Cascadia Mono</FontFamily>
  <FontFamily x:Key="FontClock">Consolas, Cascadia Mono</FontFamily>
  <FontWeight x:Key="LabelWeight">Normal</FontWeight>
  <sys:Double x:Key="SizeLabel">13</sys:Double>
  <sys:Double x:Key="SizeLabelWithDetail">12</sys:Double>
  <sys:Double x:Key="SizeClock">22</sys:Double>
  <sys:Double x:Key="SizeClockCaption">12</sys:Double>

  <!-- Terminal's density: monospaced figures need the wider timer column, and
       rows under 36 put the context bar against the label's descenders. -->
  <sys:Double x:Key="RowHeight">36</sys:Double>
  <sys:Double x:Key="RowGap">4</sys:Double>
  <sys:Double x:Key="CardPadding">8</sys:Double>
  <GridLength x:Key="TimerWidth">68</GridLength>
</ResourceDictionary>
