<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Frutiger Aero, the glossy optimism of Windows Vista and 7: see-through
       glass running from sky blue to fresh green, a bright sheen across every
       surface, bubbles and swooshes of light, white halos behind the text.
       Only what differs from Classic is here.

       The glass is tinted, not blurred: Windows only blurs behind a window as
       frosted acrylic, which also breaks this card's transparent corners. So
       the card is left clearly see-through, takes its colour from the gradient
       laid over it, and the gloss, the double edges and the decoration do what
       made Aero look like glass. -->

  <!-- The card: a third sky blue, so the desktop shows through, a dark blue
       edge and a white one inside it, which is exactly the double stroke of an
       Aero window frame. -->
  <SolidColorBrush x:Key="BrushCard"        Color="#553FA6E0" />
  <SolidColorBrush x:Key="BrushCardEdge"    Color="#E0145A96" />
  <SolidColorBrush x:Key="BrushCardInner"   Color="#D0FFFFFF" />

  <SolidColorBrush x:Key="BrushText"        Color="#072642" />
  <SolidColorBrush x:Key="BrushTextDim"     Color="#24506F" />

  <SolidColorBrush x:Key="BrushWorking"     Color="#0E8CF0" />
  <SolidColorBrush x:Key="BrushWaiting"     Color="#E848C82E" />
  <SolidColorBrush x:Key="BrushBlocked"     Color="#F0FF9A1F" />
  <SolidColorBrush x:Key="BrushDotOnBlock"  Color="#0E6FE0" />

  <!-- Rows are white glass on the blue, with the state colour as their fill. -->
  <SolidColorBrush x:Key="BrushRowBase"     Color="#60FFFFFF" />
  <SolidColorBrush x:Key="BrushTextOnWait"  Color="#08300C" />
  <SolidColorBrush x:Key="BrushTextOnBlock" Color="#4A2600" />
  <SolidColorBrush x:Key="BrushTimerOnWait"  Color="#1F5A12" />
  <SolidColorBrush x:Key="BrushTimerOnBlock" Color="#7A4A10" />

  <!-- Every row is sealed like a Windows 7 button: a darker outline in the
       row's own colour and a white highlight line just inside it. The stripe
       is the row's left side rather than a block framed by them: it covers
       the inner line where it lies, and reaches out over the outline by its
       thickness and no further, or it sticks out past the row. -->
  <Thickness x:Key="RowEdgeThickness">1</Thickness>
  <SolidColorBrush x:Key="BrushRowEdge"        Color="#A05F8FBF" />
  <SolidColorBrush x:Key="BrushRowEdgeOnWait"  Color="#FF2A8A14" />
  <SolidColorBrush x:Key="BrushRowEdgeOnBlock" Color="#FFC06A00" />
  <Thickness x:Key="RowInnerEdgeThickness">1</Thickness>
  <SolidColorBrush x:Key="BrushRowInnerEdge"   Color="#C8FFFFFF" />
  <Thickness x:Key="StripeMargin">-1,-1,0,-1</Thickness>
  <CornerRadius x:Key="StripeCorner">8,0,0,8</CornerRadius>

  <SolidColorBrush x:Key="BrushStripeText"  Color="#FFFFFF" />
  <SolidColorBrush x:Key="BrushWsNeutral"   Color="#4C86C0" />
  <SolidColorBrush x:Key="BrushWs0"         Color="#8E5BD9" />
  <SolidColorBrush x:Key="BrushWs1"         Color="#E0559B" />
  <SolidColorBrush x:Key="BrushWs2"         Color="#12A8C8" />
  <SolidColorBrush x:Key="BrushWs3"         Color="#4C86C0" />
  <SolidColorBrush x:Key="BrushHeadless"    Color="#C9A03A" />

  <SolidColorBrush x:Key="BrushCtxTrack"     Color="#26103050" />
  <SolidColorBrush x:Key="BrushCtxFill"      Color="#8C1F6FB0" />
  <SolidColorBrush x:Key="BrushCtxHigh"      Color="#E08A00" />

  <SolidColorBrush x:Key="BrushMenu"          Color="#F2EAF6FD" />
  <SolidColorBrush x:Key="BrushMenuEdge"      Color="#6A9CC4" />
  <SolidColorBrush x:Key="BrushMenuHighlight" Color="#CDE6F7" />
  <SolidColorBrush x:Key="BrushMenuTick"      Color="#1F8FE5" />
  <SolidColorBrush x:Key="BrushMenuArrow"     Color="#3D6585" />
  <SolidColorBrush x:Key="BrushMenuSeparator" Color="#30000000" />

  <!-- The card's colour lives here rather than in BrushCard: sky blue to aqua
       to green down the card. The white sheen across the top is drawn with
       the decoration below, in pixels, so it ends where the rows begin at any
       card height. The rows get their own sheen, cut off halfway down, with
       light rising again from their bottom edge. -->
  <LinearGradientBrush x:Key="CardGloss" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#505FC4F5" Offset="0" />
    <GradientStop Color="#4A3FD0E6" Offset="0.5" />
    <GradientStop Color="#5868D27A" Offset="0.85" />
    <GradientStop Color="#9078E070" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="RowGloss" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#C0FFFFFF" Offset="0" />
    <GradientStop Color="#50FFFFFF" Offset="0.48" />
    <GradientStop Color="#00FFFFFF" Offset="0.5" />
    <GradientStop Color="#00FFFFFF" Offset="0.8" />
    <GradientStop Color="#40FFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- The white halo Vista put behind the text on its glass, and only behind
       the text: a glow over the whole card haloed the green rows white too. -->
  <DropShadowEffect x:Key="TextGlow" Color="#FFFFFF" BlurRadius="8" ShadowDepth="0" Opacity="0.85" />

  <FontFamily x:Key="FontClock">Segoe UI</FontFamily>

  <!-- The decoration, in card pixels from the top left corner: the white band
       behind the header, 52 high so it ends where the rows begin and the
       header (10 down, 32 high) sits in its middle; glass bubbles along the
       edges, each a clear disc with a bright rim and a highlight; two swooshes
       of light across the middle; and a soft glare in the top left corner.
       Mostly behind the rows; it shows in the gaps between them.

       A drawing is pinned to the card's corner by its top left bound, not by
       0,0, so the whole thing is clipped to a frame from 0,0. The glare once
       reached 70 left and 60 up past the corner and so moved everything by
       that much; the decoration was liked as it looked then, so it keeps that
       place by an explicit move, and only the band sits where it was meant. -->
